{
  "name": "sortscope",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 7000 --strictPort",
    "test": "vitest run",
    "runner": "node server/index.js",
    "runner:build": "docker build -t sortscope-runner:local -f server/Dockerfile server",
    "test:e2e": "playwright test",
    "start": "node server/production.js",
    "test:runtime": "node server/smoke.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.10",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "acorn": "^8.19.0",
    "astring": "^1.9.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
